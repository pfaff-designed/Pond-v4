# Copy to .env.local and fill in. Never commit real secrets — only .env.example is tracked.

# ── Core ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Dev auto-login (local only) ──────────────────────────────────────────────
DEV_AUTOLOGIN=
DEV_EMAIL=
DEV_PASSWORD=

# ── SMS capture (F24, #14) ───────────────────────────────────────────────────
# Inbound Twilio webhook → durable "Inbox" page. Server-only; never NEXT_PUBLIC_.
TWILIO_AUTH_TOKEN=          # Twilio account auth token — validates X-Twilio-Signature
TWILIO_OWNER_USER_ID=       # Supabase auth user id that captured texts are written as
TWILIO_ALLOWED_FROM=        # comma-separated E.164 allowlist, e.g. +15551234567,+15557654321
TWILIO_WEBHOOK_URL=         # optional: exact public webhook URL when behind a proxy (ngrok/Vercel)
